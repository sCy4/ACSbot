Sub 派件費計算與分發()
    Dim ws As Worksheet
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Application.ScreenUpdating = False

    On Error Resume Next
    Set ws = wb.Sheets("漏斗")
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = ActiveSheet
        ws.Name = "漏斗"
    End If
    ws.Activate
    
    Dim lastRow As Long
    Dim i As Long
    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    
    lastRow = ws.Cells(ws.Rows.Count, "G").End(xlUp).Row
    
    Dim empID As String
    For i = lastRow To 2 Step -1
        empID = Trim(CStr(ws.Cells(i, "B").Value))
        If empID <> "" Then
            Select Case empID
    ' ==========================================
    ' ★【編輯區】在這裡修改派送員編號與對應人名
    ' ==========================================
                ' ★ 格式如下： Case "這裡寫人員編號": ws.Cells(i, "B").Value = "這裡寫人名"
                ' ★ 例如：派送員溫正杭的人員編號是20240513，所以是 Case "20240513": ws.Cells(i, "B").Value = "溫正杭"
                ' ★ 可以自行增加或減少人數，多寫幾行或刪掉幾行即可。
                ' ★ 沒有在以下名單內的資料，會在運算過程中被刪除。
                Case "21094053": ws.Cells(i, "B").Value = "林彥廷"
                Case "20298022": ws.Cells(i, "B").Value = "高鄭旺"
                Case "21002102": ws.Cells(i, "B").Value = "陳育賓"
                Case "20260504": ws.Cells(i, "B").Value = "蔡經邦"
                Case "20903101": ws.Cells(i, "B").Value = "蕭先財"
                Case "20296012": ws.Cells(i, "B").Value = "謝明憲"
                Case "20997083": ws.Cells(i, "B").Value = "林茂競"
                Case "20220418": ws.Cells(i, "B").Value = "張振發"
                Case "20251117": ws.Cells(i, "B").Value = "詹錫熏"
                Case "21192074": ws.Cells(i, "B").Value = "梁志強"
                Case "20240513": ws.Cells(i, "B").Value = "溫正杭"
                Case "20250324": ws.Cells(i, "B").Value = "戴勝堂"
                Case "20250825": ws.Cells(i, "B").Value = "謝文川"
                Case "20290022": ws.Cells(i, "B").Value = "牟善賢"
                Case "20997092": ws.Cells(i, "B").Value = "吳萌瑜"
                Case "20260305": ws.Cells(i, "B").Value = "郭香蘭"
                Case "20296021": ws.Cells(i, "B").Value = "詹益全"
                Case "21005222": ws.Cells(i, "B").Value = "鄒樂勳"
                Case "20289041": ws.Cells(i, "B").Value = "趙克強"
                Case "20240710": ws.Cells(i, "B").Value = "蔡俊傑"
                
                ' ★ 這裡也要跟著修改。
                ' ★ 最後一行的最後不需要加「,」或「_」符號。
                Case "林彥廷", "高鄭旺", "陳育賓", "蔡經邦", "蕭先財", "謝明憲", "林茂競", _
                     "張振發", "詹錫熏", "梁志強", "溫正杭", "戴勝堂", "謝文川", "牟善賢", "吳萌瑜", _
                     "郭香蘭", "詹益全", "鄒樂勳", "趙克強", "蔡俊傑"
                Case Else
                    ws.Rows(i).Delete
            End Select
        End If
    Next i
    
    lastRow = ws.Cells(ws.Rows.Count, "G").End(xlUp).Row
    If lastRow < 2 Then
        Application.ScreenUpdating = True
        Exit Sub
    End If

    Dim key As String
    Dim dateStr As String
    
    For i = 2 To lastRow
        If IsDate(ws.Cells(i, "A").Value) Then
            dateStr = Format(ws.Cells(i, "A").Value, "yyyy/mm/dd")
        Else
            dateStr = ws.Cells(i, "A").Text
        End If
        key = dateStr & "|" & ws.Cells(i, "B").Value & "|" & ws.Cells(i, "E").Value
        If Not dict.Exists(key) Then dict.Add key, New Collection
        dict(key).Add i
    Next i
    
    Dim vKey As Variant, r As Variant
    Dim maxRow As Long, maxG As Double, currentG As Double
    Dim origG As Double, feeJ As Double, feeK As Double
    Dim isGroup As Boolean
    
    For Each vKey In dict.Keys
        isGroup = (dict(vKey).Count > 1)
        maxRow = dict(vKey).Item(1)
        If IsNumeric(ws.Cells(maxRow, "G").Value) And Not IsEmpty(ws.Cells(maxRow, "G").Value) Then maxG = ws.Cells(maxRow, "G").Value Else maxG = 0
        
        For Each r In dict(vKey)
            If IsNumeric(ws.Cells(r, "G").Value) And Not IsEmpty(ws.Cells(r, "G").Value) Then currentG = ws.Cells(r, "G").Value Else currentG = 0
            If currentG > maxG Then
                maxG = currentG
                maxRow = r
            End If
        Next r
        
        For Each r In dict(vKey)
            If isGroup Then
                ws.Range(ws.Cells(r, "A"), ws.Cells(r, "F")).Interior.Color = RGB(190, 229, 250)
            Else
                ws.Range(ws.Cells(r, "A"), ws.Cells(r, "F")).Interior.Pattern = xlNone
            End If
            
            If IsNumeric(ws.Cells(r, "G").Value) And Not IsEmpty(ws.Cells(r, "G").Value) Then
                origG = Application.WorksheetFunction.Round(ws.Cells(r, "G").Value, 2)
            Else
                origG = 0
            End If
            
            feeJ = 0
            feeK = 0
            
            If r = maxRow Then
                If origG >= 10 Then
                    ws.Cells(r, "H").Value = 10
                    ws.Cells(r, "I").Value = Application.WorksheetFunction.Round(origG - 10, 2)
                Else
                    ws.Cells(r, "H").Value = origG
                    ws.Cells(r, "I").Value = 0
                End If
                feeJ = 10
                feeK = Application.WorksheetFunction.Round(ws.Cells(r, "I").Value * 0.3, 2)
                If feeK > 0 And feeK < 3 Then feeK = 3
                
                ws.Cells(r, "J").Value = feeJ
                If feeK = 0 Then ws.Cells(r, "K").Value = "" Else ws.Cells(r, "K").Value = feeK
                ws.Cells(r, "L").Value = Application.WorksheetFunction.Round(feeJ + feeK, 2)
                If ws.Cells(r, "I").Value = 0 Then ws.Cells(r, "I").Value = ""
            Else
                ws.Cells(r, "H").Value = ""
                ws.Cells(r, "I").Value = origG
                ws.Cells(r, "J").Value = ""
                
                feeK = Application.WorksheetFunction.Round(ws.Cells(r, "I").Value * 0.3, 2)
                If feeK > 0 And feeK < 3 Then feeK = 3
                
                If feeK = 0 Then ws.Cells(r, "K").Value = "" Else ws.Cells(r, "K").Value = feeK
                ws.Cells(r, "L").Value = feeK
                If ws.Cells(r, "I").Value = 0 Then ws.Cells(r, "I").Value = ""
            End If
        Next r
    Next vKey
    
    ws.Range("G1").Value = "總重"
    ws.Range("H1").Value = "首重"
    ws.Range("I1").Value = "續重"
    ws.Range("J1").Value = "首重費"
    ws.Range("K1").Value = "續重費"
    ws.Range("L1").Value = "派件費"
    
    With ws.Cells
        .Font.Name = "新細明體"
        .Font.Size = 11
        .HorizontalAlignment = xlLeft
    End With
    ws.Range("G2:L" & lastRow).NumberFormat = "General"
    
    ws.Range("G2:G" & lastRow).Interior.Color = RGB(181, 216, 204)
    ws.Range("H2:I" & lastRow).Interior.Color = RGB(249, 247, 243)
    ws.Range("J2:K" & lastRow).Interior.Color = RGB(239, 226, 174)
    ws.Range("L2:L" & lastRow).Interior.Color = RGB(248, 170, 128)
    
    With ws.Range("A1:L1")
        .Interior.Color = RGB(12, 110, 163)
        .Font.Color = vbWhite
    End With
    ws.Rows(1).RowHeight = 30
    
    ws.Columns("A").ColumnWidth = 16
    ws.Columns("B").ColumnWidth = 8
    ws.Columns("C").ColumnWidth = 19
    ws.Columns("D").ColumnWidth = 18
    ws.Columns("E").ColumnWidth = 48
    ws.Columns("F").ColumnWidth = 5
    ws.Columns("G").ColumnWidth = 5
    ws.Columns("H").ColumnWidth = 5
    ws.Columns("I").ColumnWidth = 5
    ws.Columns("J").ColumnWidth = 7
    ws.Columns("K").ColumnWidth = 7
    ws.Columns("L").ColumnWidth = 7

    ws.Activate
    With ActiveWindow
        If .FreezePanes Then .FreezePanes = False
        .SplitColumn = 0
        .SplitRow = 1
        .FreezePanes = True
    End With

    With ws.Sort
        .SortFields.Clear
        .SortFields.Add key:=ws.Range("A2:A" & lastRow), SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortNormal
        .SetRange ws.Range("A1:L" & lastRow)
        .Header = xlYes
        .MatchCase = False
        .Orientation = xlTopToBottom
        .SortMethod = xlPinYin
        .Apply
    End With

    Dim nameDict As Object
    Set nameDict = CreateObject("Scripting.Dictionary")
    Dim pName As String
    
    For i = 2 To lastRow
        pName = Trim(CStr(ws.Cells(i, "B").Value))
        If pName <> "" Then
            If Not nameDict.Exists(pName) Then nameDict.Add pName, 1
        End If
    Next i
    
    Dim newWs As Worksheet
    Dim vName2 As Variant
    Dim empLastRow As Long
    Dim dupDict As Object
    Dim rDup As Long
    Dim dupKey As String
    Dim colIndex As Integer
    
    Application.DisplayAlerts = False
    
    For Each vName2 In nameDict.Keys
        Set newWs = Nothing
        On Error Resume Next
        Set newWs = wb.Sheets(CStr(vName2))
        On Error GoTo 0
        
        If newWs Is Nothing Then
            Set newWs = wb.Sheets.Add(After:=wb.Sheets(wb.Sheets.Count))
            newWs.Name = CStr(vName2)
        End If

        empLastRow = newWs.Cells(newWs.Rows.Count, "A").End(xlUp).Row
        
        If empLastRow > 1 And (newWs.Cells(empLastRow, "A").Value = "加總" Or newWs.Cells(empLastRow, "E").Value = "加總") Then
            newWs.Rows(empLastRow).Delete
            empLastRow = empLastRow - 1
        End If

        ws.Range("A1:L" & lastRow).AutoFilter Field:=2, Criteria1:=CStr(vName2)
        If ws.Range("A1:L" & lastRow).Columns(1).SpecialCells(xlCellTypeVisible).Count > 1 Then
            ws.Range("A2:L" & lastRow).SpecialCells(xlCellTypeVisible).Copy Destination:=newWs.Range("A" & empLastRow + 1)
        End If
        
        empLastRow = newWs.Cells(newWs.Rows.Count, "A").End(xlUp).Row
        
        If empLastRow > 1 Then

            Set dupDict = CreateObject("Scripting.Dictionary")
            For rDup = empLastRow To 2 Step -1
                dupKey = newWs.Cells(rDup, 1).Value & "|" & newWs.Cells(rDup, 2).Value & "|" & _
                         newWs.Cells(rDup, 3).Value & "|" & newWs.Cells(rDup, 4).Value & "|" & _
                         newWs.Cells(rDup, 5).Value & "|" & newWs.Cells(rDup, 6).Value & "|" & _
                         newWs.Cells(rDup, 7).Value

                If dupDict.Exists(dupKey) Then
                    newWs.Rows(rDup).Delete
                Else
                    dupDict.Add dupKey, 1
                End If
            Next rDup

            empLastRow = newWs.Cells(newWs.Rows.Count, "A").End(xlUp).Row

            With newWs.Sort
                .SortFields.Clear
                .SortFields.Add key:=newWs.Range("A2:A" & empLastRow), SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortNormal
                .SetRange newWs.Range("A1:L" & empLastRow)
                .Header = xlYes
                .MatchCase = False
                .Orientation = xlTopToBottom
                .SortMethod = xlPinYin
                .Apply
            End With

            ws.Range("A1:L1").Copy Destination:=newWs.Range("A1")
            newWs.Rows(1).RowHeight = 30

            With newWs.Cells
                .Font.Name = "新細明體"
                .Font.Size = 11
                .HorizontalAlignment = xlLeft
            End With

            newWs.Columns("A").ColumnWidth = 16
            newWs.Columns("B").ColumnWidth = 8
            newWs.Columns("C").ColumnWidth = 19
            newWs.Columns("D").ColumnWidth = 18
            newWs.Columns("E").ColumnWidth = 48
            newWs.Columns("F").ColumnWidth = 5
            newWs.Columns("G").ColumnWidth = 5
            newWs.Columns("H").ColumnWidth = 5
            newWs.Columns("I").ColumnWidth = 5
            newWs.Columns("J").ColumnWidth = 7
            newWs.Columns("K").ColumnWidth = 7
            newWs.Columns("L").ColumnWidth = 7

            newWs.Range("G2:G" & empLastRow + 1).Interior.Color = RGB(181, 216, 204)
            newWs.Range("H2:I" & empLastRow + 1).Interior.Color = RGB(249, 247, 243)
            newWs.Range("J2:K" & empLastRow + 1).Interior.Color = RGB(239, 226, 174)
            newWs.Range("L2:L" & empLastRow + 1).Interior.Color = RGB(248, 170, 128)

            With newWs.Cells(empLastRow + 1, "E")
                .Value = "加總"
                .HorizontalAlignment = xlRight
            End With
            newWs.Rows(empLastRow + 1).Font.Bold = True

            For colIndex = 6 To 12
                newWs.Cells(empLastRow + 1, colIndex).Formula = "=SUM(" & newWs.Cells(2, colIndex).Address(False, False) & ":" & newWs.Cells(empLastRow, colIndex).Address(False, False) & ")"
            Next colIndex
            
            With newWs.Range(newWs.Cells(empLastRow + 1, "F"), newWs.Cells(empLastRow + 1, "L")).Borders
                .LineStyle = xlContinuous
                .Weight = xlThin
            End With

            newWs.Activate
            With ActiveWindow
                If .FreezePanes Then .FreezePanes = False
                .SplitColumn = 0
                .SplitRow = 1
                .FreezePanes = True
            End With
        End If
    Next vName2
    
    ws.AutoFilterMode = False
    ws.Activate
    
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    MsgBox "計算並分發完成", vbInformation
End Sub

Sub 清空漏斗資料()
    Dim ws As Worksheet

    On Error Resume Next
    Set ws = ActiveWorkbook.Sheets("漏斗")
    On Error GoTo 0

    If ws Is Nothing Then
        MsgBox "找不到名為「漏斗」的工作表。", vbExclamation
        Exit Sub
    End If

    Application.ScreenUpdating = False

    ws.Cells.Clear

    ws.Activate
    ws.Range("A1").Select
    
    Application.ScreenUpdating = True

    MsgBox "漏斗工作表已清空", vbInformation
End Sub

